{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and skincare data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "skinType": { "type": "string" },
        "sensitivity": { "type": "string" },
        "concerns": { "type": "array", "items": { "type": "string" } },
        "onboardingCompleted": { "type": "boolean" },
        "tier": { "type": "string", "enum": ["free", "premium"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "tier"]
    },
    "RoutineLog": {
      "title": "Routine Log",
      "description": "Log of completed routines",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["morning", "night"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SkinLog": {
      "title": "Skin Log",
      "description": "Daily skin condition check-ins",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "acne": { "type": "number" },
        "oiliness": { "type": "number" },
        "dryness": { "type": "number" },
        "irritation": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/routineLogs/{logId}": {
      "schema": "RoutineLog",
      "description": "User routine history"
    },
    "/users/{userId}/skinLogs/{logId}": {
      "schema": "SkinLog",
      "description": "User skin check-in history"
    }
  }
}
