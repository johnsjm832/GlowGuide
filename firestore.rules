rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId);

      match /routineLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /skinLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /feedback/{feedbackId} {
      allow create: if true; // Public submission
      allow read: if false; // Only admins can read (needs further rule logic if manual admin is needed)
    }
  }
}
